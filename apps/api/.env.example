PORT=4000
ADMIN_KEY=dev-admin
# Optional service token for scripts (smoke test, eval). People sign in with
# accounts created by `npm run user:create`. Leave empty in production.
APP_API_KEY=dev-app-key
DATABASE_URL=postgresql://podcast:podcast@localhost:5432/podcast_ai
OPENAI_API_KEY=your_openai_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-6-luna
# Rewrites questions into search queries (empty: gpt-5.4-mini). gpt-4.1-mini
# was another second faster in the eval but misjudged the question's language
# more often; see docs/verification.md.
OPENAI_PLAN_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
MIN_GROUNDING_SCORE=0.45
# Apple Podcasts store used for podcast search (two-letter country code).
PODCAST_SEARCH_COUNTRY=NO
# Comma-separated browser origins allowed by CORS. Empty: no CORS headers.
CORS_ORIGINS=
# Set (e.g. to 1) when the API runs behind a reverse proxy, so rate limits use
# the client address from X-Forwarded-For.
TRUST_PROXY=
# Transcribed audio kept for playback; must be the same directory as the
# worker's. Empty: <repo>/.local/audio.
AUDIO_STORAGE_DIR=
# Signs the expiring audio links. Empty: derived from ADMIN_KEY.
MEDIA_URL_SECRET=
# Public origin for absolute audio links, e.g. https://podcast.example.com.
# Empty: links are relative to the API origin.
PUBLIC_BASE_URL=
# Audio minutes that may be transcribed per UTC day, shared by all users. 0: no limit.
DAILY_TRANSCRIPTION_MINUTES=180
