DATABASE_URL=postgresql://podcast:podcast@localhost:5432/podcast_ai
OPENAI_API_KEY=your_openai_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EMBED_MODEL=text-embedding-3-small
WORKER_POLL_INTERVAL_MS=10000
MAX_EPISODE_AUDIO_MB=80
DEFAULT_MAX_EPISODES_PER_SOURCE=10
# Required for ~30-second audio chunks with real citation offsets.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
