DATABASE_URL=postgresql://podcast:podcast@localhost:5432/podcast_ai
OPENAI_API_KEY=your_openai_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EMBED_MODEL=text-embedding-3-small
# Writes episode summaries and chapters after transcription.
OPENAI_CHAT_MODEL=gpt-6-luna
WORKER_POLL_INTERVAL_MS=10000
# Downloads stream to disk; a 2-hour MP3 at 128 kbps is about 115 MB.
MAX_EPISODE_AUDIO_MB=500
DEFAULT_MAX_EPISODES_PER_SOURCE=10
# Automatic retries per episode. A user can still request a failed episode again.
MAX_TRANSCRIPTION_ATTEMPTS=3
# Parallel transcription requests per episode.
TRANSCRIBE_CONCURRENCY=4
# Clips are cut in pauses between 0.5x and 1.5x this length.
AUDIO_CHUNK_TARGET_SEC=20
# A processing job without a heartbeat for this long is picked up again.
STALE_JOB_MINUTES=10
# Lets the worker fetch loopback/private addresses, needed for the local demo
# feed on 127.0.0.1. Set to false when the API is reachable by other people.
ALLOW_PRIVATE_NETWORK_FEEDS=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
