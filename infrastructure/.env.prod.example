# Production settings for infrastructure/docker-compose.prod.yml.
#
#   cp infrastructure/.env.prod.example infrastructure/.env.prod
#   chmod 600 infrastructure/.env.prod
#
# Fill in the values marked REQUIRED. Never commit the filled-in file
# (.env.* is git-ignored). Generate secrets on the server, for example:
#   openssl rand -hex 32
# Empty optional values use the default shown in the comment.

# ---------------------------------------------------------------------------
# Stack
# ---------------------------------------------------------------------------

# REQUIRED. Public host name of the API, e.g. podcast.example.com. Its DNS A
# record must point at this server; Caddy then gets an HTTPS certificate.
# DOMAIN=localhost gives a self-signed local certificate (testing only).
DOMAIN=

# REQUIRED. Password of the bundled PostgreSQL. Use hex (openssl rand -hex 32):
# it is embedded in DATABASE_URL. Only read when the database volume is first
# created; changing it later needs ALTER USER inside PostgreSQL as well.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Shared by API and worker
# ---------------------------------------------------------------------------

# Optional. Empty = the bundled database:
#   postgresql://podcast:${POSTGRES_PASSWORD}@postgres:5432/podcast_ai
# Set only to use an external/managed PostgreSQL with pgvector >= 0.8.
DATABASE_URL=

# REQUIRED. OpenAI API key (server-side only; never put it in the app).
OPENAI_API_KEY=

# Models. Empty = defaults: gpt-transcribe, text-embedding-3-small, gpt-6-luna.
# API and worker must use the same embedding model (1536 dimensions).
OPENAI_TRANSCRIBE_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_CHAT_MODEL=

# AUDIO_STORAGE_DIR=/data/audio
# Fixed in docker-compose.prod.yml: the shared audio volume is mounted there in
# both api and worker. Not read from this file.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# PORT=4000
# Fixed in docker-compose.prod.yml: Caddy proxies to api:4000. Not read from this file.

# REQUIRED. Key for the /v1/admin endpoints (header x-admin-key). Long random value.
ADMIN_KEY=

# Optional shared service token (Authorization: Bearer ...). Leave empty in
# production; people sign in with their own accounts. Note: application
# versions without user accounts refuse to start while this is empty.
APP_API_KEY=

# Model that rewrites questions into search queries. Empty = OPENAI_CHAT_MODEL.
OPENAI_PLAN_MODEL=

# Spoken answers. Empty = gpt-realtime-2.1-mini.
OPENAI_TTS_MODEL=

# Minimum retrieval similarity before the API answers. Empty = 0.45.
MIN_GROUNDING_SCORE=

# Apple Podcasts store searched when adding podcasts (two-letter code). Empty = US.
PODCAST_SEARCH_COUNTRY=NO

# Comma-separated browser origins allowed by CORS. Empty = no CORS headers
# (the mobile app does not need CORS).
CORS_ORIGINS=

# Which proxies the API trusts for X-Forwarded-For (client address for rate
# limits). Empty = uniquelocal: trust private addresses, i.e. Caddy on the
# Docker network. Do not use 1 here: the API passes the value to Express as a
# string, which reads "1" as an IP address, not as a hop count.
TRUST_PROXY=

# REQUIRED. Secret that signs episode media URLs. Long random value
# (openssl rand -hex 32). Changing it invalidates links already handed out.
MEDIA_URL_SECRET=

# Public base URL used in links the API returns. Empty = https://${DOMAIN}.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# How often the worker checks for queued jobs, in ms. Empty = 10000.
WORKER_POLL_INTERVAL_MS=

# Largest episode download in MB. Empty = 500 (a 2-hour 128 kbps MP3 is ~115 MB).
MAX_EPISODE_AUDIO_MB=

# Episodes imported per podcast when a job gives no limit. Empty = 10.
DEFAULT_MAX_EPISODES_PER_SOURCE=

# Automatic transcription attempts per episode. Empty = 3.
MAX_TRANSCRIPTION_ATTEMPTS=

# Parallel transcription requests per episode. Empty = 4.
TRANSCRIBE_CONCURRENCY=

# Target clip length in seconds (clips are cut in pauses, 0.5x-1.5x). Empty = 20.
AUDIO_CHUNK_TARGET_SEC=

# A processing job without a heartbeat for this many minutes is retried. Empty = 10.
STALE_JOB_MINUTES=

# ALLOW_PRIVATE_NETWORK_FEEDS=false
# Fixed to false in docker-compose.prod.yml: on a public server the worker must
# never fetch loopback or private-network addresses. Not read from this file.

# Paths of the FFmpeg tools (installed in the worker image). Empty = ffmpeg / ffprobe.
FFMPEG_PATH=
FFPROBE_PATH=

# How often subscribed feeds are checked for new episodes, in minutes. Empty = 60.
FEED_REFRESH_MINUTES=

# Daily cap on transcribed audio, in minutes; bounds transcription spend. Empty = 180.
DAILY_TRANSCRIPTION_MINUTES=
