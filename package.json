{
  "name": "podcast-ai-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "AI-grounded podcast voice Q&A prototype",
  "workspaces": [
    "apps/api",
    "apps/worker",
    "packages/shared-types"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "db:up": "cd infrastructure && docker compose up -d",
    "db:down": "cd infrastructure && docker compose down",
    "seed": "./scripts/seed.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
