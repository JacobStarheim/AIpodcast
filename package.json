{
  "name": "podcast-ai-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "AI-grounded podcast voice Q&A prototype",
  "workspaces": [
    "apps/api",
    "apps/worker",
    "packages/shared-types"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/shared-types && npm run build --workspace apps/api && npm run build --workspace apps/worker",
    "test": "npm run test --workspaces --if-present",
    "test:db": "node scripts/test-db.mjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/worker run dev",
    "db:up": "cd infrastructure && docker compose up -d --wait && cd .. && node scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:down": "cd infrastructure && docker compose down",
    "demo:serve": "node scripts/demo-server.mjs",
    "test:live": "node scripts/smoke-live.mjs",
    "eval": "node scripts/eval/run-eval.mjs",
    "seed": "./scripts/seed.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
